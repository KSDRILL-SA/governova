// Governova Cloud — Stage 1 data model.
//
// `S5.9` makes this file the single source of truth for the schema; every change
// to the database is a change here first and a migration second.
//
// `#255` asks for something more specific before any of that: **run
// `governova schema` on this file.** That command analyses data-model soundness
// against C14 and had never had a real customer. A data-model analyser whose
// author did not run it on their own schema is a recommendation nobody should
// take, so this schema was written, analysed, and corrected before anything was
// built on it. The findings and what was done about them are recorded in
// `platform/cloud/prisma/README.md`.
//
// Every model below carries the four things C05 requires of a table:
//   - a UUID primary key, never an autoincrementing integer (`AP-S5.10a`) — a
//     sequential id publishes the total record count and makes the next one
//     guessable
//   - `created_at` / `updated_at` / `deleted_at` (`S5.34`)
//   - `NOT NULL` on every field that is required (`S5.29`) — optionality is
//     expressed by `?` and nothing else
//   - uniqueness enforced here rather than in application code (`S5.30`),
//     because two concurrent requests both read *absent* and both write

generator client {
  provider = "prisma-client-py"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The three operating modes from `master.md` §16. An organisation declares one;
/// it changes which protocols are active, never the constitutional framework.
///
/// Named after the modes rather than after billing tiers on purpose — the tiers
/// change with a price list, and the modes are constitutional.
enum OperatingMode {
  PERSONAL
  TEAM
  ENTERPRISE
}

/// What a member may do inside an organisation. Distinct from `OperatingMode`,
/// which is a property of the organisation itself.
enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

/// A person. `subject` is the identity service's `sub` claim — the only link
/// between this database and Stage 0, and the reason nothing here stores a
/// credential.
model Account {
  id         String    @id @default(uuid())
  subject    String    @unique
  email      String    @unique
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  memberships Membership[]

  @@index([deleted_at])
}

/// The billed entity. **Seats are the unit that is billed; projects are never
/// counted** — counting projects is the crippled-tier thinking `ADR-010`
/// retired.
model Organisation {
  id              String        @id @default(uuid())
  slug            String        @unique
  name            String
  mode            OperatingMode @default(PERSONAL)
  seats_purchased Int           @default(1)
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt
  deleted_at      DateTime?

  memberships Membership[]
  teams       Team[]
  ledger      LedgerEntry[]

  @@index([deleted_at])
}

/// The bridge between a person and an organisation (`S14.9`).
///
/// A person may belong to several organisations and an organisation has many
/// people, so the relationship is many-to-many and needs an entity of its own.
/// It also has attributes — a role, and whether a seat is occupied — which is
/// the second reason a join table cannot be implicit here.
model Membership {
  id               String     @id @default(uuid())
  organisation_id  String
  account_id       String
  role             MemberRole @default(MEMBER)
  /// Null means a member who occupies no seat. Seats are counted from this
  /// column, so an unoccupied membership costs nothing.
  seat_assigned_at DateTime?
  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt
  deleted_at       DateTime?

  organisation Organisation @relation(fields: [organisation_id], references: [id])
  account      Account      @relation(fields: [account_id], references: [id])

  team_memberships TeamMembership[]

  /// `S5.30` — one membership per person per organisation, enforced here. In
  /// application code, two concurrent invitations both read absent and both
  /// write, and the duplicate exists before either transaction commits.
  @@unique([organisation_id, account_id])
  /// The target of `TeamMembership`'s composite foreign key. `id` is already
  /// unique on its own; this pair exists so a referencing row must name the
  /// organisation it believes this membership belongs to, and be wrong loudly
  /// if it does not.
  @@unique([organisation_id, id])
  /// `S5.13` — every foreign key column carries an index.
  @@index([organisation_id])
  @@index([account_id])
  @@index([deleted_at])
}

/// A group inside one organisation.
model Team {
  id              String    @id @default(uuid())
  organisation_id String
  name            String
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?

  organisation Organisation     @relation(fields: [organisation_id], references: [id])
  members      TeamMembership[]

  @@unique([organisation_id, name])
  /// The other target of `TeamMembership`'s composite foreign key — see there.
  @@unique([organisation_id, id])
  @@index([organisation_id])
  @@index([deleted_at])
}

/// The bridge between a team and a membership (`S14.9`).
///
/// It points at `Membership` rather than at `Account` deliberately. A team
/// belongs to exactly one organisation, and its members must belong to that
/// same organisation — going through `Membership` makes that relationship
/// expressible; going through `Account` would allow a person with no membership
/// to sit on a team.
///
/// **`organisation_id` is carried here on purpose, and it is a denormalisation.**
/// `S14.8` requires that to be recorded rather than assumed, so: the column
/// duplicates a fact reachable through either `team` or `membership`, and it
/// exists because **one shared column is what makes the two foreign keys
/// composite**. Both references below are keyed on `organisation_id` plus the
/// row's own id, so a team in one organisation and a membership in another
/// cannot both satisfy them. The invariant becomes impossible rather than
/// merely checked.
///
/// The alternative was an application-level check, and it was rejected: an
/// application invariant holds only for code that calls it. A migration, a bulk
/// import, a support script or a direct `INSERT` all bypass it, and every one of
/// those is a normal thing to do to a production database. The cost is one
/// column and two composite unique constraints on the referenced tables.
model TeamMembership {
  id              String    @id @default(uuid())
  /// Denormalised from `team.organisation_id` / `membership.organisation_id`,
  /// which the composite foreign keys below force to agree with each other.
  organisation_id String
  team_id         String
  membership_id   String
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?

  team       Team       @relation(fields: [organisation_id, team_id], references: [organisation_id, id])
  membership Membership @relation(fields: [organisation_id, membership_id], references: [organisation_id, id])

  @@unique([team_id, membership_id])
  @@index([organisation_id])
  @@index([team_id])
  @@index([membership_id])
  @@index([deleted_at])
}

/// Why a balance moved. Mirrors `governova_ledger.EntryKind`; the vocabulary is
/// closed so entries can be summed and reconciled, which a free-text reason
/// cannot be.
enum LedgerEntryKind {
  ACCRUAL
  CONSUMPTION
  GRANT
  REFUND
  EXPIRY
}

/// One immutable movement of credit.
///
/// **Append-only, and therefore the one model here with no `deleted_at` and no
/// `updated_at`.** `S5.34` asks every table for those three columns and this
/// table deliberately carries one: a ledger entry that can be soft-deleted is
/// not append-only, and a balance derived from entries that can disappear is not
/// derivable from anything. A movement is reversed by a `REFUND` entry, which is
/// a fact, rather than by hiding the entry that is being reversed.
///
/// **`@@unique([organisation_id, idempotency_key])` is what actually prevents a
/// double charge.** The application also keeps an index of keys, and that index
/// is useless under the condition that matters: two deliveries of the same
/// webhook arriving at two processes both find no key and both write. Only the
/// database sees both. `S5.30` says exactly this — uniqueness is enforced here,
/// not in application code — and the ledger was built the other way round first.
///
/// Scoped to the organisation rather than global because an idempotency key is
/// the payment provider's event id, and two organisations' events are unrelated.
/// A global constraint would make one tenant's key collide with another's.
model LedgerEntry {
  id              String          @id @default(uuid())
  organisation_id String
  /// Position in this organisation's hash chain. Starts at 1.
  seq             Int
  kind            LedgerEntryKind
  /// Integer ten-thousandths of a credit, unsigned. **Never a float, and never a
  /// `Decimal` column either** — the value that is hashed and the value that is
  /// stored must be the same bytes, and a decimal's textual form depends on how
  /// it was constructed. Direction comes from `kind` (`ADR-011`, `AP-S5.28a`).
  amount_minor    BigInt
  idempotency_key String
  occurred_at     DateTime
  detail          String          @default("")
  /// The previous entry's `record_hash`, or 64 zeroes for the first.
  prev_hash       String
  record_hash     String
  created_at      DateTime        @default(now())

  organisation Organisation @relation(fields: [organisation_id], references: [id])

  /// The double-charge constraint. See the note above.
  @@unique([organisation_id, idempotency_key])
  /// One entry per position, so a chain cannot fork or repeat a sequence number.
  @@unique([organisation_id, seq])
  @@index([organisation_id])
  @@index([occurred_at])
}
